# Copy to .env.local for local work. .env* is gitignored; this file is not.

# ---------------------------------------------------------------------------
# Runtime -- the only variable the site itself reads.
# ---------------------------------------------------------------------------

# The live origin, with protocol and no trailing slash.
#
# Every Open Graph and Twitter image URL resolves against this, and so do
# sitemap.xml and robots.txt. Left unset it falls back to http://localhost:3000,
# which is harmless locally and quietly broken in production: the site renders
# fine, but every preview card points at the sharer's own machine and the image
# fails to load for everyone else.
#
# Include the protocol. A value without one throws at build time, which is the
# intended behaviour -- it fails loudly rather than shipping broken cards.
# A trailing slash is tolerated and stripped.
#
# SET THIS ON THE HOST BEFORE THE FIRST PRODUCTION DEPLOY.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Build tooling -- not needed to run or deploy the site, only to re-sync design
# data. Both are read by scripts/figma-pull.mjs, which is run by hand.
# ---------------------------------------------------------------------------

# A Figma personal access token. Never commit a real one.
FIGMA_TOKEN=

# The Figma file to pull from. The script has a default, so this is an override.
FIGMA_FILE_KEY=
